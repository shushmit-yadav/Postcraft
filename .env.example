# --- Backend ---------------------------------------------------------------
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://app:app@localhost:5432/social_gen
# Secret used to sign session cookies and file download URLs (min 32 chars).
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Where uploads and generated files are stored (local disk provider).
STORAGE_DIR=./data/storage
# Allowed browser origin in dev (Vite dev server).
WEB_ORIGIN=http://localhost:5173

# --- AI provider -----------------------------------------------------------
# Leave empty to use the built-in deterministic MockProvider (no key needed).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Worker ----------------------------------------------------------------
WORKER_CONCURRENCY=2
