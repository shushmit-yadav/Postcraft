{
  "name": "social-content-generator",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "concurrently -k -n api,worker,web -c blue,magenta,green \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:api": "npm run dev:api -w @app/backend",
    "dev:worker": "npm run dev:worker -w @app/backend",
    "dev:web": "npm run dev -w @app/web",
    "db:up": "docker compose up -d postgres",
    "db:generate": "npm run db:generate -w @app/backend",
    "db:migrate": "npm run db:migrate -w @app/backend",
    "build": "npm run build -w @app/shared --if-present && npm run build -w @app/backend && npm run build -w @app/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  }
}
